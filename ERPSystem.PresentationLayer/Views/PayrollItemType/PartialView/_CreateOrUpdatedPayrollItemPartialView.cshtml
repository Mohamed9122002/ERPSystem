@using ERPSystem.PresentationLayer.ViewModels.Payroll_temType
@model PayrollItemTypeViewModel
<input type="hidden" asp-for="Id" />
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Kind" class="form-label"></label>
    <select asp-for="Kind" class="form-select"
            asp-items="Html.GetEnumSelectList<PayrollItemKind>()">
    </select>
    <span asp-validation-for="Kind" class="text-danger"></span>
</div>

<div class="form-check mb-3">
    <input asp-for="IsPercentage" class="form-check-input" type="checkbox" />
    <label asp-for="IsPercentage" class="form-check-label"></label>
</div>

<div class="mb-3">
    <label asp-for="Percentage" class="form-label"></label>
    <input asp-for="Percentage" class="form-control" />
    <span asp-validation-for="Percentage" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="FixedAmount" class="form-label"></label>
    <input asp-for="FixedAmount" class="form-control" />
    <span asp-validation-for="FixedAmount" class="text-danger"></span>
</div>

<div class="form-check mb-4">
    <input asp-for="IsTaxRelated" class="form-check-input" type="checkbox" />
    <label asp-for="IsTaxRelated" class="form-check-label"></label>
</div>