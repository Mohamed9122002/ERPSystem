@model IEnumerable<PayrollItemTypeDto>
@{
	ViewData["Title"] = "Index";
}

<div class="container mt-5">
	<h2> PayrollItem Type</h2>
	<div class="d-flex justify-content-between align-items-center mb-3">
		<a asp-action="Create" class="btn btn-success">
			<i class="fas fa-plus me-1"></i> Create PayrollItem Type
		</a>
	</div>
	@if (TempData["Message"] != null)
	{
		<div class="alert alert-success">@TempData["Message"]</div>
	}
	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger">@TempData["ErrorMessage"]</div>
	}

	<table class="mt-4 table table-striped table-hover">
		<thead class="table-success">
			<tr>
				<th>@Html.DisplayNameFor(model => model.First().Name)</th>
				<th>@Html.DisplayNameFor(model => model.First().IsPercentage)</th>
				<th>@Html.DisplayNameFor(model => model.First().Percentage)</th>
				<th>@Html.DisplayNameFor(model => model.First().FixedAmount)</th>
				<th>@Html.DisplayNameFor(model => model.First().IsTaxRelated)</th>
				<th>@Html.DisplayNameFor(model => model.First().Kind)</th>
				<th>Details</th>
				<th>Edit</th>
				<th>Delete</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>

					<td>@Html.DisplayFor(m => item.Name)</td>
	
					<td>@Html.DisplayFor(m => item.IsPercentage)</td>
					<td>@Html.DisplayFor(m => item.Percentage)</td>
					<td>@Html.DisplayFor(m => item.FixedAmount)</td>
					<td>@Html.DisplayFor(m => item.IsTaxRelated)</td>
					<td>
						@switch (item.Kind)
						{
							case PayrollItemKind.Allowance:
								<span class="badge bg-success">Allowance</span>
								break;
							case PayrollItemKind.Deduction:
								<span class="badge bg-danger">Deduction</span>
								break;
						}
					</td>
					<td>
						<a asp-action="Details" asp-route-id="@item .Id" class="btn btn btn-warning me-1">
							<i class="fas fa-edit"></i> Details
						</a>
					</td>
					<td>
						<a asp-action="Edit" asp-route-id="@item.Id" class="btn  btn-primary me-1">
							<i class="fas fa-edit"></i> Edit
						</a>
					</td>
					<td>
						<button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#DeleteModal-@item.Id">
							<i class="fas fa-trash"></i> Delete
						</button>
						<div class="modal fade" id="DeleteModal-@item.Id" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
							<div class="modal-dialog">
								<div class="modal-content">
									<div class="modal-header">
										<h1 class="modal-title fs-5" id="exampleModalLabel">Delete Attendance</h1>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
									</div>
									<div class="modal-body">
										Are you sure you want to delete PayrollItem Type <strong>@item.Name</strong>?
									</div>
									<div class="modal-footer">
										<form asp-action="Delete" asp-controller="PayrollItemType" asp-route-id="@item.Id">
											<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
											<input type="submit" value="Delete" class="btn btn-danger" />
										</form>
									</div>
								</div>
							</div>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>



