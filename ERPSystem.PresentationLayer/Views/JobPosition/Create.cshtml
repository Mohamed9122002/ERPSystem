@using ERPSystem.BusinessLogicLayer.HRServices.DepartmentS
@inject IDepartmentService _departmentService
@model JobPositionViewModel
@{
    ViewData["Title"] = "Create";
	var Departments = new SelectList(await _departmentService.GetAllDepartmentsAsync(), "Id", "Name");
}

<div class="row justify-content-center align-items-center flex-column">
	<h1 class="col-6 my-4">Create New Employee</h1>
	<br />

	<form method="post" asp-controller="JobPosition" asp-action="Create" class="row col-6" enctype="multipart/form-data">
		<div asp-validation-summary="ModelOnly"></div>
		<div class="form-group col-12">
			<label class="form-label" asp-for="Title"></label>
			<input asp-for="Title" class="form-control" />
			<span asp-validation-for="Title" class="text-danger"></span>
		</div>
		<div class="form-group col-12">
			<label class="form-label" asp-for="Description"></label>
			<input asp-for="Description" class="form-control" />
			<span asp-validation-for="Description" class="text-danger"></span>
		</div>
		<div class="form-group col-12">
			<label asp-for="DepartmentId" class="control-label"></label>
			<select asp-for="DepartmentId" asp-items="Departments" class="form-control">
				<option value="@null">
					Choose JobPosition
				</option>
			</select>
			<span asp-validation-for="DepartmentId" class="text-danger"></span>
		</div>
		<div class="mt-4">
			<input type="submit" value="Create" class="btn btn-primary" /> |
			<a asp-controller="JobPosition" asp-action="Index" class="btn btn-light">Back To List</a>
		</div>


	</form>
	</div>
