@model ShiftViewModel
<div class="mb-3">
	<label asp-for="Name" class="form-label"></label>
	<input asp-for="Name" class="form-control" />
	<span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
	<label asp-for="ShiftType" class="form-label"></label>
	<select asp-for="ShiftType" class="form-select">
		<option value="">-- Select Shift Type --</option>
		@foreach (var type in Enum.GetValues(typeof(ShiftType)))
		{
			<option value="@type">@type</option>
		}
	</select>
	<span asp-validation-for="ShiftType" class="text-danger"></span>
</div>

<div class="row">
	<div class="col-md-6 mb-3">
		<label asp-for="StartTime" class="form-label"></label>
		<input asp-for="StartTime" type="time" class="form-control" />
		<span asp-validation-for="StartTime" class="text-danger"></span>
	</div>

	<div class="col-md-6 mb-3">
		<label asp-for="EndTime" class="form-label"></label>
		<input asp-for="EndTime" type="time" class="form-control" />
		<span asp-validation-for="EndTime" class="text-danger"></span>
	</div>
</div>
<div class="mb-3">
	<label asp-for="BreakMinutes" class="form-label"></label>
	<input asp-for="BreakMinutes" type="number" class="form-control" min="0" />
	<span asp-validation-for="BreakMinutes" class="text-danger"></span>
</div>