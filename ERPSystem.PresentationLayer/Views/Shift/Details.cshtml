@model ShiftViewModel
@{
    ViewData["Title"] = "Details";
    var startDateTime = DateTime.Today.Add(Model.StartTime);
    var endDateTime = DateTime.Today.Add(Model.EndTime);
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
                    <h3 class="mb-0">Shift Details</h3>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.Name)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.Name)</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.ShiftType)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.ShiftType)</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.StartTime)</dt>
                        <dd class="col-sm-8">@startDateTime.ToString(@"hh\:mm tt")</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.EndTime)</dt>
                        <dd class="col-sm-8">@endDateTime.ToString(@"hh\:mm tt")</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.BreakMinutes)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.BreakMinutes)</dd>
                    </dl>

                    <!-- ==== Assigned Employees ===== -->
                    <h5 class="mt-4">Assigned Employees (@Model.AssignedEmployees.Count)</h5>

                    @if (Model.AssignedEmployees.Any())
                    {
                        <table class="table table-bordered mt-3">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th style="width: 100px;">Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var emp in Model.AssignedEmployees)
                                {
                                    <tr>
                                        <td>@emp.FullName</td>
                                        <td class="text-center">
                                            <form asp-action="RemoveEmployee" method="post"
                                                  asp-route-shiftId="@Model.Id"
                                                  asp-route-employeeId="@emp.Id">
                                                <button class="btn btn-sm btn-danger">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info mt-2">No employees assigned to this shift.</div>
                    }
                    <form asp-action="AssignEmployees" method="post">
                        <input type="hidden" name="shiftId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">Select Employees:</label>
                            <select class="form-select" name="employeesId" multiple size="6">
                                @foreach (var emp in Model.AllEmployees)
                                {
                                    <option value="@emp.Id">@emp.FullName</option>
                                }
                            </select>
                            <small class="text-muted">Hold Ctrl (or Cmd) to select multiple employees.</small>
                        </div>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check me-1"></i> Assign Employees
                        </button>
                    </form>
                </div>

                <div class="card-footer text-center py-3 bg-light rounded-bottom-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-2">@TempData["ErrorMessage"]</div>
}
