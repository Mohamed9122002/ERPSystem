
@model AssignEmployeeViewModel
@{
    ViewData["Title"] = "AssignEmployeeTraining";
}

<h2 class="mb-4">Assign Employees to @Model.TrainingTitle</h2>

<form asp-action="AssignEmployeeTraining" method="post">
    <input type="hidden" asp-for="TrainingId" />

    <div class="row">
        @foreach (var emp in Model.Employees)
        {
            <div class="col-md-4 mb-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="EmployeeIds" value="@emp.Id"
                           id="emp_@emp.Id"
                           @(Model.SelectedEmployeeIds.Contains(emp.Id) ? "checked" : "") />
                    <label class="form-check-label" for="emp_@emp.Id">
                        @emp.FullName
                    </label>
                </div>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary mt-3">Save</button>
</form>

