@using ERPSystem.BusinessLogicLayer.HRServices.JobPositionS
@using ERPSystem.DataAccessLayer.Modules.HR.enums

@model EmployeeViewModel
@inject IJobPositionServices _jobPositionServices
@{
    ViewData["Title"] = "Create";
    var jobPositions = (await _jobPositionServices.GetAllJobPositionsAsync())
                        .Select(jp => new SelectListItem
                        {
                            Value = jp.Id.ToString(),
                            Text = jp.Title,
						}).ToList();
}

<h1>Create Employee</h1>
<form asp-controller="Employee" asp-action="Create" method="post" class="row col-6">
    <div asp-validation-summary="ModelOnly"></div>
    <partial name="PartialView/_CreateEditEmployeePartialView" />
    <div class="mb-3">
        <label asp-for="ShiftId" class="form-label"></label>
        <select asp-for="ShiftId" asp-items="ViewBag.Shifts" class="form-select">
            <option value="">-- Optional Shift --</option>
        </select>
        <span asp-validation-for="ShiftId" class="text-danger"></span>
    </div>

	<div class="mt-4">
			<input type="submit" value="Create" class="btn btn-primary" /> |
			<a asp-controller="Employee" asp-action="Index" class="btn btn-light">Back To List</a>
		</div>
</form>


