
@model EmployeeViewModel

@{
    ViewData["Title"] = "Updated";

}
<div class="row justify-content-center align-content-center mt-3">
    <h1 class="col-8 my-4">Update Employee</h1>
    <form asp-controller="Employee" asp-action="Updated" method="post" class="row col-6">
    <div asp-validation-summary="ModelOnly"></div>
    <partial name="PartialView/_CreateEditEmployeePartialView" />
    <div class="mb-3">
        <label asp-for="ShiftId" class="form-label"></label>
        <select asp-for="ShiftId" asp-items="ViewBag.Shifts" class="form-select">
            <option value="">-- Optional Shift --</option>
        </select>
        <span asp-validation-for="ShiftId" class="text-danger"></span>
    </div>
        <div class="mt-4 m-auto">
            <input class="btn btn-success" type="submit" value="Save" />
            <a asp-controller="Department" asp-action="Index" class="btn btn-outline-dark">Back to list</a>
        </div>
    </form>
</div>