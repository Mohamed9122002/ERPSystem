@using ERPSystem.DataAccessLayer.Modules.HR.enums
@model EmployeeViewModel



    <!-- Full Name -->
    <div class="col-md-6">
        <label class="form-label" asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
<div class="col-md-6">
    <label class="form-label" asp-for="NationalID"></label>
    <input asp-for="NationalID" class="form-control" />
    <span asp-validation-for="NationalID" class="text-danger"></span>
</div>
    <!-- Email -->
    <div class="col-md-6">
        <label class="form-label" asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <!-- Address -->
    <div class="col-md-6">
        <label class="form-label" asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <!-- Age -->
    <div class="col-md-6">
        <label class="form-label" asp-for="Age"></label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <!-- Salary -->
    <div class="col-md-6">
        <label class="form-label" asp-for="Salary"></label>
        <input asp-for="Salary" class="form-control" />
        <span asp-validation-for="Salary" class="text-danger"></span>
    </div>

    <!-- Phone -->
    <div class="col-md-6">
        <label class="form-label" asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <!-- Employee Type -->
    <div class="col-md-6">
        <label class="form-label" asp-for="EmployeeType"></label>
        <select asp-for="EmployeeType" asp-items="Html.GetEnumSelectList<ContractType>()" class="form-select">
            <option value="">Select Employee Type</option>
        </select>
        <span asp-validation-for="EmployeeType" class="text-danger"></span>
    </div>

    <!-- Partial Dropdowns (Departments / Job Positions) -->
    <div class="col-6">
        <partial name="_EmployeeDropdowns" />
    </div>

    <!-- Gender -->
    <div class="col-md-6">
        <label class="form-label">Gender</label>
        <div>
            @foreach (Gender genderOption in Enum.GetValues(typeof(Gender)))
            {
                <div class="form-check form-check-inline">
                    <input type="radio" class="form-check-input" asp-for="Gender" value="@genderOption" />
                    <label class="form-check-label">@genderOption</label>
                </div>
            }
        </div>
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>

    <!-- Hire Date -->
    <div class="col-md-6">
        <label class="form-label" asp-for="HireDate"></label>
        <input type="date" asp-for="HireDate" class="form-control" />
        <span asp-validation-for="HireDate" class="text-danger"></span>
    </div>

<div class="form-group col-12 my-3">
    <div class="form-check">

        <input type="checkbox" asp-for="Status" class="form-check-input" />
        <label class=" form-check-label" asp-for="Status"></label>
    </div>
</div>