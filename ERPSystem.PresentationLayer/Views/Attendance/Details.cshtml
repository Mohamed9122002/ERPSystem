@using ERPSystem.BusinessLogicLayer.DataTransferObject.AttendanceDtos
@using ERPSystem.PresentationLayer.ViewModels.Attendance
@model AttendanceViewModel
@{
    ViewData["Title"] = "Details";
}

<div class="container mt-5">
    <h2>Attendance Details</h2>

    <div class="card mt-4">
        <div class="card-header bg-primary text-white">
            @Model.EmployeeName
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Employee Name</dt>
                <dd class="col-sm-9">@Model.EmployeeName</dd>
                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@Model.Date.ToShortDateString()</dd>

                <dt class="col-sm-3">Check In</dt>
                <dd class="col-sm-9">
                    @(Model.CheckIn.HasValue? Model.CheckIn.Value.ToString("HH:mm") : "Not Checked In")
                </dd>

                <dt class="col-sm-3">Check Out</dt>
                <dd class="col-sm-9">
                    @(Model.CheckOut.HasValue? Model.CheckOut.Value.ToString("HH:mm") : "Not Checked Out")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @switch (Model.Status)
                    {
                        case AttendanceStatus.Present:
                            <span class="badge bg-success">Present</span>
                            break;
                        case AttendanceStatus.Absent:
                            <span class="badge bg-warning text-dark">Partial</span>
                            break;
                        case AttendanceStatus.Late:
                            <span class="badge bg-danger">Late</span>
                            break;
                        case AttendanceStatus.OnLeave:
                            <span class="badge bg-secondary">On Leave</span>
                            break;
                    }
                </dd>
            </dl>

            <a asp-action="Index" class="btn btn-secondary mt-3">Back to List</a>
        </div>
    </div>
</div>
