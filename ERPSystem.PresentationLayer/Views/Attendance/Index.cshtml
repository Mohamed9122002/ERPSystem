@using ERPSystem.BusinessLogicLayer.DataTransferObject.AttendanceDtos

@model IEnumerable<AttendanceListDto>
@{
	ViewData["Title"] = "Attendance";
}

<div class="container mt-5">
	<h2>Employee Attendance</h2>
	<div class="d-flex justify-content-between align-items-center mb-3">
		<a asp-action="Create" class="btn btn-success">
			<i class="fas fa-plus me-1"></i> Create Attendance
		</a>
	</div>
	@if (TempData["Message"] != null)
	{
		<div class="alert alert-success">@TempData["Message"]</div>
	}
	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger">@TempData["ErrorMessage"]</div>
	}

	<table class="mt-4 table table-striped table-hover">
		<thead class="table-success">
			<tr>
				<th>Employee</th>
				<th>Date</th>
				<th>Check In</th>
				<th>Check Out</th>
				<th>Status</th>
				<th>Edit</th>
				<th>Delete</th>
				<th>Details</th>
				<th>CheckIn</th>
				<th>CheckOut</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var att in Model)
			{
				<tr>
					<td>@att.EmployeeName</td>
					<td>@att.Date.ToShortDateString()</td>
					<td>@(att.CheckIn?.ToString("HH:mm") ?? "-")</td>
					<td>@(att.CheckOut?.ToString("HH:mm") ?? "-")</td>
					<td>
						@switch (att.Status)
						{
							case AttendanceStatus.Present:
								<span class="badge bg-success">Present</span>
								break;
							case AttendanceStatus.Absent:
								<span class="badge bg-warning text-dark">Partial</span>
								break;
							case AttendanceStatus.Late:
								<span class="badge bg-danger">Late</span>
								break;
							case AttendanceStatus.OnLeave:
								<span class="badge bg-secondary">OnLeave </span>
								break;
						}
					</td>	
					<td>
						<a asp-action="Details" asp-route-id="@att.Id" class="btn btn btn-warning me-1">
							<i class="fas fa-edit"></i> Details
						</a>
					</td>
					<td>
						<a asp-action="Edit" asp-route-id="@att.Id" class="btn  btn-primary me-1">
							<i class="fas fa-edit"></i> Edit
						</a>
					</td>
					<td>
						<button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#DeleteModal-@att.Id">
							<i class="fas fa-trash"></i> Delete
						</button>
						<div class="modal fade" id="DeleteModal-@att.Id" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
							<div class="modal-dialog">
								<div class="modal-content">
									<div class="modal-header">
										<h1 class="modal-title fs-5" id="exampleModalLabel">Delete Attendance</h1>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
									</div>
									<div class="modal-body">
										Are you sure you want to delete Attendance <strong>@att.EmployeeName</strong>?
									</div>
									<div class="modal-footer">
										<form asp-action="Delete" asp-controller="Attendance" asp-route-id="@att.Id">
											<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
											<input type="submit" value="Delete" class="btn btn-danger" />
										</form>
									</div>
								</div>
							</div>
						</div>
					</td>
					<td>
						@if (att.CheckIn == null)
						{
							<form asp-controller="Attendance" asp-action="CheckIn" asp-route-id="@att.Id" method="post">
								<button type="submit" class="btn btn-success btn-sm">
									Check In
								</button>
							</form>
						}
						else
						{
							<span class="badge bg-success">Checked In</span>
						}
					</td>

					<td>
						@if (att.CheckOut == null)
						{
							<form asp-controller="Attendance" asp-action="CheckOut" asp-route-id="@att.Id" method="post">
								<button type="submit" class="btn btn-danger btn-sm">
									Check Out
								</button>
							</form>
						}
						else
						{
							<span class="badge bg-danger">Checked Out</span>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

