@using ERPSystem.BusinessLogicLayer.DataTransferObject.AttendanceDtos
@model IEnumerable<AttendanceListDto>

<div class="container mt-5">
    <h2>Employee Attendance</h2>

    <table class="mt-4 table table-striped table-hover">
        <thead class="table-success">
            <tr>
                <th>@Html.DisplayNameFor(m => m.First().EmployeeName)</th>
                <th>@Html.DisplayNameFor(m => m.First().Date)</th>
                <th>@Html.DisplayNameFor(m => m.First().CheckIn)</th>
                <th>@Html.DisplayNameFor(m => m.First().CheckOut)</th>
                <th>Status</th>
                <th>@Html.DisplayNameFor(m => m.First().WorkingHours)</th>
                <th>@Html.DisplayNameFor(m => m.First().LateHours)</th>
                <th>@Html.DisplayNameFor(m => m.First().OvertimeHours)</th>
                <th>Edit</th>
                <th>Delete</th>
                <th>Details</th>
                <th>CheckIn</th>
                <th>CheckOut</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var att in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(m => att.EmployeeName)</td>
                    <td>@att.Date.ToShortDateString()</td>
                    <td>@(att.CheckIn?.ToString("HH:mm") ?? "-")</td>
                    <td>@(att.CheckOut?.ToString("HH:mm") ?? "-")</td>
                    @* الحالة ديناميكية *@
                    @{
                        var statusText = "-";
                        var badgeClass = "bg-secondary";

                        if (!att.CheckIn.HasValue)
                        {
                            statusText = "Absent";
                            badgeClass = "bg-warning text-dark";
                        }
                        else if (!att.CheckOut.HasValue)
                        {
                            statusText = "Checked In";
                            badgeClass = "bg-info text-dark";
                        }
                        else
                        {
                            if (att.WorkingHours >= 8)
                            {
                                statusText = "Present";
                                badgeClass = "bg-success";
                            }
                            else
                            {
                                statusText = "Late";
                                badgeClass = "bg-danger";
                            }
                        }
                    }
                    <td><span class="badge @badgeClass">@statusText</span></td>

                    <td>@Html.DisplayFor(m => att.WorkingHours)</td>
                    <td>@Html.DisplayFor(m => att.LateHours)</td>
                    <td>@Html.DisplayFor(m => att.OvertimeHours)</td>
                    <td>
                        <a  asp-action="Details" asp-route-id="@att.Id" class="btn btn-warning">
                            <i class="fas fa-eye"></i> Details
                        </a>
                    </td>
                    <td>
                        <a  asp-action="Edit" asp-route-id="@att.Id" class="btn btn-success">
                            <i class="fas fa-edit"></i> Update
                        </a>
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#DeleteModal-@att.Id">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                        <div class="modal fade" id="DeleteModal-@att.Id" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Delete Employee</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are you sure you want to delete employee <strong>@att.EmployeeName</strong>?
                                    </div>
                                    <div class="modal-footer">
                                        <form asp-action="Delete"  asp-route-id="@att.Id">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <input type="submit" value="Delete" class="btn btn-danger" />
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>

                    <td>
                        @if (!att.CheckIn.HasValue)
                        {
                            <form asp-controller="Attendance" asp-action="CheckIn" asp-route-id="@att.Id" method="post">
                                <button type="submit" class="btn btn-success btn-sm">Check In</button>
                            </form>
                        }
                        else
                        {
                            <span class="badge bg-success">Checked In</span>
                        }
                    </td>

                    <td>
                        @if (!att.CheckOut.HasValue)
                        {
                            <form asp-controller="Attendance" asp-action="CheckOut" asp-route-id="@att.Id" method="post">
                                <button type="submit" class="btn btn-danger btn-sm">Check Out</button>
                            </form>
                        }
                        else
                        {
                            <span class="badge bg-danger">Checked Out</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
